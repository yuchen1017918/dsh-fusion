# 复制成 keystore.properties 后填写（该文件已被 .gitignore 排除）。
# 路径相对于「根工程」，不是相对于本文件。
#
# 也可以完全不建这个文件，改用环境变量（CI 里更合适）：
#   DSH_FUSION_STORE_FILE / DSH_FUSION_STORE_PASSWORD
#   DSH_FUSION_KEY_ALIAS  / DSH_FUSION_KEY_PASSWORD
storeFile=keystore/dsh-fusion.jks
storePassword=改成你自己的口令
keyAlias=dsh-fusion
keyPassword=改成你自己的口令

<?xml version="1.0" encoding="utf-8"?>
<!--
  能力声明尽量精确：模型要的是「点、滑、读屏、输入文本」，
  不需要监听窗口变化之外的东西 —— 声明得越窄，用户越敢开。
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewFocused"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagReportViewIds|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:notificationTimeout="120"
    android:description="@string/accessibility_label" />
